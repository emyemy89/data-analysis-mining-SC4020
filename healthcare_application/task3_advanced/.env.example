# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# Model Settings
MODEL_DIR=models
TRAIN_ON_STARTUP=false

# Frontend URL (for production)
FRONTEND_URL=http://localhost:3000
